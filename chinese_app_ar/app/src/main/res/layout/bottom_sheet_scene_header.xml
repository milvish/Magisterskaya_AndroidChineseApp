<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bottom_sheet_background"
    android:divider="@drawable/material_divider_1"
    android:elevation="2dp"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:orientation="horizontal"
    android:outlineProvider="background"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:showDividers="middle"
    tools:showIn="@layout/bottom_sheet_scene">


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/recording"
        style="@style/HeaderButton"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:enabled="false"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_recording"
        app:tint="@null"
        tools:ignore="ContentDescription" />

    <com.example.chinese_app_ar.ui.ar.ImageViewPreventScroll
        android:id="@+id/add"
        style="@style/HeaderButton"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:enabled="false"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_add_node"
        tools:ignore="ContentDescription" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/playPause"
        style="@style/HeaderButton"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:srcCompat="@drawable/ic_play_pause"
        tools:ignore="ContentDescription" />

    <com.example.chinese_app_ar.ui.ar.ImageViewPreventScroll
        android:id="@+id/description"
        style="@style/HeaderButton"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:enabled="false"
        app:srcCompat="@drawable/ic_description"
        tools:ignore="ContentDescription" />

</LinearLayout>