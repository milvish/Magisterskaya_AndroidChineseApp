<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/fragment_current_lesson"
    android:layout_margin="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/iconPhonetics"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="10dp"
            android:visibility="gone"
            android:src="@drawable/ic_arrow_drop_down_circle"/>
        <TextView
            android:id="@+id/titlePhonetics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/lesson_hsk_1"
            android:visibility="gone"
            android:text="Фонетика"/>

    </LinearLayout>


        <TextView
            android:id="@+id/descriptionPhonetics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/dark_blue"
            android:layout_marginHorizontal="10dp"
            android:visibility="gone"
            android:text="1. Новые слова: 生病、帮助、事情、告诉、药、让、忙、帮、病人、看病 \n 2. Диалоги \nDialogue 1 A: 你生病了吗？(nǐ shēng bìng le ma)\nB: 是的，我需要去看病。(shì de, wǒ xū yào qù kàn bìng) \nDialogue 2 A: 我需要你的帮助。(wǒ xū yào nǐ de bāng zhù) \nB: 我很忙，但是我可以帮你。\nDialogue 3 A: 这件事你告诉我了吗？(zhè jiàn shì nǐ gào su wǒ le ma) \nB: 没有，我还没有告诉你。(méi yǒu, wǒ hái méi yǒu gào su nǐ)"/>

        <androidx.media3.ui.PlayerView
            android:id="@+id/phoneticsExoplayerView"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/iconGrammar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="10dp"
            android:visibility="gone"
            android:src="@drawable/ic_arrow_drop_down_circle"/>
        <TextView
            android:id="@+id/titleGrammar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/lesson_hsk_1"
            android:visibility="gone"
            android:text="Грамматика"/>

    </LinearLayout>
        <TextView
            android:id="@+id/descriptionGrammar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginHorizontal="10dp"
            android:textColor="@color/dark_blue"
            android:visibility="gone"
            android:text="1) Предложения с 请、让、叫"/>


        <androidx.media3.ui.PlayerView
            android:id="@+id/grammarExoplayerView"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="10dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/iconHieroglyphics"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="10dp"
            android:visibility="gone"
            android:src="@drawable/ic_arrow_drop_down_circle"/>
        <TextView
            android:id="@+id/titleHieroglyphics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/lesson_hsk_1"
            android:visibility="gone"
            android:text="Иероглифика"/>


    </LinearLayout>
        <TextView
            android:id="@+id/descriptionHieroglyphics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:textSize="12sp"
            android:textColor="@color/dark_blue"
            android:visibility="gone"
            android:text="Изучение написания иероглифов"/>

        <androidx.media3.ui.PlayerView
            android:id="@+id/hieroglyphicsExoplayerView"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="10dp"/>

        <Button
            android:id="@+id/testButton"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:text="Пройти тест"
            android:layout_gravity="center"
            />
    </LinearLayout>

</ScrollView>