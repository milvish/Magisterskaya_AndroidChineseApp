<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_margin="4dp"
    android:elevation="10dp"
    app:cardCornerRadius="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/statistic_text"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:textColor="@color/statistic_2"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Android" />

            <LinearLayout
                android:id="@+id/fromTo"
                android:layout_width="100dp"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="С :"
                    android:textSize="12sp"
                    app:tint="@color/orange" />
            <TextView
                android:id="@+id/dateStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="date"
                android:textColor="@color/statistic_3"
                android:textSize="14sp"
                app:tint="@color/orange" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="По :"
                    android:textSize="12sp"
                    app:tint="@color/orange" />
                <TextView
                    android:id="@+id/dateEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="date"
                    android:textColor="@color/statistic_3"
                    android:textSize="14sp"
                    app:tint="@color/orange" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/singleDate"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginHorizontal="8dp"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="date"
                    android:textColor="@color/statistic_3"
                    android:textSize="14sp"
                    app:tint="@color/orange" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/count_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="70"
                    android:textColor="@color/lesson_hsk_1"
                    android:textSize="20sp"
                    app:tint="@color/orange" />
                <TextView
                    android:id="@+id/count_days_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/lesson_hsk_1"
                    tools:text="дней \nназад"/>



            </LinearLayout>
        </LinearLayout>





</androidx.cardview.widget.CardView>